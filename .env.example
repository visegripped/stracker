# Environment Variables Template
# Copy this file to .env.local for local development

# Postgres (Neon connection string)
POSTGRES_URL=postgresql://user:password@host/stracker?sslmode=require

# Google OAuth — same client as giftmanager
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here

# Published Google Sheet CSV URL (public — no auth required)
# Format: https://docs.google.com/spreadsheets/d/e/PACX-1v.../pub?gid=0&single=true&output=csv
GOOGLE_SHEET_CSV_URL=

# Resend email API key (https://resend.com)
RESEND_API_KEY=

# Email recipient for daily cron error notifications
ERROR_EMAIL=

# Cron job protection — any string locally, a strong secret in production
CRON_SECRET=local-dev-cron-secret

# Optional: Yahoo Finance session cookies from a logged-in browser.
# Logging in at finance.yahoo.com does NOT automatically apply to Node.
# DevTools → Network → any query*.finance.yahoo.com request → copy the Cookie header.
# YAHOO_COOKIE=A1=...; A3=...; Y=...; T=...
#
# Optional ticker remaps (sheet symbol:Yahoo symbol), comma-separated.
# SGH→PENG is built in. Example: YAHOO_SYMBOL_ALIASES=TEF:TEF.MC
# YAHOO_SYMBOL_ALIASES=

# Secret sauce formulas (do NOT commit real formulas)
# Local: keep formulas in lib/secretSauce.local.ts (gitignored)
# Vercel: set SECRET_SAUCE_MODULE_B64 — generate with: pnpm encode-secret-sauce
# SECRET_SAUCE_MODULE_B64=
# SECRET_SAUCE_MODULE=   # optional: raw TypeScript source

# App version is set automatically from package.json at build time (see next.config.ts)
